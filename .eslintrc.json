{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": ["node_modules", ".next", "dist", "supabase/**"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint"],
  "overrides": [
    {
      "files": ["src/accounting/**/*.ts", "src/accounting/**/*.tsx"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "error"
      }
    }
  ]
}
