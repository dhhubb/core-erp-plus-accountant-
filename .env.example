# Local Supabase (see `supabase status`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Test connection URL (tests run against the real local Postgres)
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Redis (R2 promotion candidate cache; tests use a real Redis)
REDIS_URL=redis://127.0.0.1:6379

# Supabase local JWT secret (well-known local default)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
